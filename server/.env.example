# Copy to .env and paste the PostgreSQL connection string from Supabase.
# For a persistent FastAPI server use the Direct connection when IPv6 works;
# otherwise copy the Session pooler URI from the Supabase Connect dialog.
# Include sslmode=require. Keep this secret out of source control.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
